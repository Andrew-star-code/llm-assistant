# Локальные переопределения api и воркеров дев-стенда (не в git): скопируйте в api.local.env.
# Формат — APP_<секция>__<параметр>=значение (вложенность через «__»), см. docs/reference/config.md.

# --- Настоящий реранкер (make dev-models-up) вместо fake-llm: для make eval-rag и проверки поиска
# APP_MODELS__RERANK__BASE_URL=http://rerank:80
# APP_MODELS__RERANK__MODEL=BAAI/bge-reranker-v2-m3
# APP_MODELS__RERANK__API=tei
# На CPU реранк 60 кандидатов идёт ~5 с — со стартовыми 3 с чат всегда уходил бы в RRF без реранка.
# APP_RAG__SEARCH__RERANK__TIMEOUT_S=15

# --- Живая чат-модель на машине разработчика (Ollama, llama.cpp, vLLM) — docs/guides/add-model.md
# APP_MODELS__CHAT__BASE_URL=http://host.docker.internal:11434/v1
# APP_MODELS__CHAT__MODEL=qwen3:8b

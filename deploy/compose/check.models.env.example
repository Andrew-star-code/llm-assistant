# Модели для проверочного стенда (compose.check.yml): скопируйте в check.models.env (не в git).
# Адрес — имя контейнера модели в сети ai-check-models и порт ВНУТРИ контейнера;
# MODEL — как в `GET /v1/models` у этой модели (--served-model-name).
# Формат — APP_<секция>__<параметр>; все параметры — docs/reference/config.md, раздел models.

APP_MODELS__CHAT__BASE_URL=http://<контейнер чат-модели>:8000/v1
APP_MODELS__CHAT__MODEL=<имя модели>
APP_MODELS__CHAT__CONTEXT_LENGTH=131072
APP_MODELS__CHAT__MAX_OUTPUT_TOKENS=16384
APP_MODELS__CHAT__SUPPORTS_TOOLS=true
# Точный счёт токенов (§8.3): скопируйте tokenizer.json модели в config/tokenizers/chat/
# (каталог config смонтирован в контейнеры как /srv/config; config/tokenizers — не в git).
# APP_MODELS__CHAT__TOKENIZER=/srv/config/tokenizers/chat/tokenizer.json

APP_MODELS__UTILITY__BASE_URL=http://<контейнер служебной модели>:8000/v1
APP_MODELS__UTILITY__MODEL=<имя модели>

APP_MODELS__EMBED__BASE_URL=http://<контейнер embed>:80/v1
APP_MODELS__EMBED__MODEL=BAAI/bge-m3

APP_MODELS__RERANK__BASE_URL=http://<контейнер rerank>:80/v1
APP_MODELS__RERANK__MODEL=BAAI/bge-reranker-v2-m3
APP_MODELS__RERANK__API=tei

# Модели, которых на сервере нет, монитор здоровья не проверяет.
APP_MODELS__CODER__DEPLOYED=false
APP_MODELS__GUARD__DEPLOYED=false

# Скопируйте в deploy/compose/.env (make dev-up делает это сам) и при необходимости поменяйте.
# Здесь — секреты и адреса (§16.4). Файл .env в git не коммитится.

APP_VERSION=dev
APP_ENV=dev

POSTGRES_DB=assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=dev-postgres-password

REDIS_PASSWORD=dev-redis-password
QDRANT_API_KEY=dev-qdrant-api-key

# mock-AD (только дев-стенд). Пароль сервисной учётки svc-ai-assistant = LDAP_BIND_PASSWORD.
MOCK_AD_ADMIN_PASSWORD=Dev-Admin-Passw0rd!
LDAP_BIND_PASSWORD=Dev-Svc-Passw0rd!
MOCK_AD_USER_PASSWORD=Passw0rd!

# Шлюз данных (§9.5): общий секрет api ↔ data-gateway (не короче 16 символов) и логин источника
# mssql_main только на чтение. На дев-стенде источник — контейнер mock-mssql.
DATA_GATEWAY_SECRET=dev-data-gateway-secret
MSSQL_HOST=mock-mssql
MSSQL_DATABASE=corp
MSSQL_USER=dg_reader
MSSQL_PASSWORD=Dev-Reader-Passw0rd!
MOCK_MSSQL_SA_PASSWORD=Dev-Sa-Passw0rd!

# Папка на сервере с документами для массового импорта в базы знаний (§10.3); в контейнерах —
# /srv/import только для чтения. Импорт: админка «Базы знаний» или
# docker compose … exec api python -m app.cli kb import --kb <код> <подпапка>
KB_IMPORT_DIR=./import

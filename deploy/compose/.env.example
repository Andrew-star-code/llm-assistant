# Скопируйте в deploy/compose/.env (make dev-up делает это сам) и при необходимости поменяйте.
# Здесь — секреты и адреса (§16.4). Файл .env в git не коммитится.

APP_VERSION=dev
APP_ENV=dev

POSTGRES_DB=assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=dev-postgres-password

REDIS_PASSWORD=dev-redis-password
QDRANT_API_KEY=dev-qdrant-api-key

# mock-AD (только дев-стенд). Пароль сервисной учётки svc-ai-assistant = LDAP_BIND_PASSWORD.
MOCK_AD_ADMIN_PASSWORD=Dev-Admin-Passw0rd!
LDAP_BIND_PASSWORD=Dev-Svc-Passw0rd!
MOCK_AD_USER_PASSWORD=Passw0rd!

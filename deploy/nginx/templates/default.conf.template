# Публичный вход портала (§16.2): TLS, /api → api, остальное → frontend.
# Шаблон образа nginx: при старте контейнера ${PORTAL_HOST} подставляется из окружения
# (compose.prod.yml), переменные nginx ($host и др.) остаются как есть.
# Проверка: make test-nginx.

server {
    listen 80;
    server_name ${PORTAL_HOST};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PORTAL_HOST};
    server_tokens off;

    ssl_certificate     /run/secrets/tls_fullchain.pem;
    ssl_certificate_key /run/secrets/tls_privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 60m;            # files.max_file_mb (50) + запас (runbook, проблема Е3)

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_set_header Connection "";      # keep-alive к api: без него — новое соединение на запрос

    location /api/ {
        proxy_pass http://api:8000;
        # SSE: без буферизации и с долгим чтением, иначе ответ приходит одним куском в конце
        # (проблема Е1) или обрывается через минуту (Е2).
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        gzip off;
    }

    # Метрики и служебные проверки api наружу не публикуются (§16.6).
    location /metrics { return 404; }

    location / {
        proxy_pass http://frontend:8080;
    }
}
